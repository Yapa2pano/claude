{{ 'reliefroll.css' | asset_url | stylesheet_tag }}
{%- assign s = section.settings -%}
<div class="rr rr--{{ s.bg }}" style="--rr-pt: {{ s.pt }}px; --rr-pb: {{ s.pb }}px;">
  <div class="rr-wrap">
    <div class="rr-head">
      {%- if s.eyebrow != blank -%}<p class="rr-eyebrow">{{ s.eyebrow }}</p>{%- endif -%}
      {%- if s.heading != blank -%}<h2 class="rr-h2">{{ s.heading }}</h2>{%- endif -%}
      {%- if s.text != blank -%}<div class="rr-lead">{{ s.text }}</div>{%- endif -%}
    </div>
    <div class="rr-grid" style="--rr-cols: {{ s.columns }};">
      {%- for block in section.blocks -%}
        {%- assign b = block.settings -%}
        <div class="rr-card" {{ block.shopify_attributes }}>
          {%- if s.show_images -%}
            {% render 'rr-media', image: b.image, fallback: b.fallback, label: b.image_label, ratio: s.ratio, sizes: '(min-width: 990px) 33vw, (min-width: 600px) 50vw, 100vw', product: product %}
          {%- endif -%}
          <div class="rr-card__body">
            <div class="rr-card__top">
              <span class="rr-ico-badge">{% render 'rr-icon', name: b.icon %}</span>
              <h3 class="rr-h3">{{ b.title }}</h3>
            </div>
            {%- if b.text != blank -%}<div>{{ b.text }}</div>{%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>
{% schema %}
{"name":"RR · Bénéfices","tag":"section","class":"rr-section","settings":[{"type":"text","id":"eyebrow","label":"Petit titre (au-dessus)"},{"type":"text","id":"heading","label":"Titre","default":"Ce qui change pour vous"},{"type":"richtext","id":"text","label":"Sous-titre"},{"type":"select","id":"columns","label":"Colonnes (ordinateur)","options":[{"value":"2","label":"2"},{"value":"3","label":"3"},{"value":"4","label":"4"}],"default":"3"},{"type":"checkbox","id":"show_images","label":"Afficher les images","default":true},{"type":"select","id":"ratio","label":"Format des images","options":[{"value":"1 / 1","label":"Carré"},{"value":"4 / 3","label":"Paysage"},{"value":"4 / 5","label":"Portrait"}],"default":"4 / 3"},{"type":"header","content":"Style de la section"},{"type":"select","id":"bg","label":"Couleur de fond","options":[{"value":"white","label":"Blanc"},{"value":"sand","label":"Sable"},{"value":"mint","label":"Menthe"},{"value":"ink","label":"Nuit (foncé)"}],"default":"white"},{"type":"range","id":"pt","label":"Marge haute","min":0,"max":140,"step":4,"unit":"px","default":72},{"type":"range","id":"pb","label":"Marge basse","min":0,"max":140,"step":4,"unit":"px","default":72}],"blocks":[{"type":"benefit","name":"Bénéfice","settings":[{"type":"select","id":"icon","label":"Icône","options":[{"value":"check","label":"check"},{"value":"check-circle","label":"check-circle"},{"value":"truck","label":"truck"},{"value":"shield","label":"shield"},{"value":"refresh","label":"refresh"},{"value":"lock","label":"lock"},{"value":"clock","label":"clock"},{"value":"battery","label":"battery"},{"value":"bolt","label":"bolt"},{"value":"hand","label":"hand"},{"value":"moon","label":"moon"},{"value":"sun","label":"sun"},{"value":"heart","label":"heart"},{"value":"leaf","label":"leaf"},{"value":"usb","label":"usb"},{"value":"waves","label":"waves"},{"value":"target","label":"target"},{"value":"user","label":"user"},{"value":"bed","label":"bed"},{"value":"feather","label":"feather"},{"value":"gift","label":"gift"},{"value":"chat","label":"chat"},{"value":"box","label":"box"},{"value":"star","label":"star"},{"value":"x-circle","label":"x-circle"}],"default":"check-circle"},{"type":"text","id":"title","label":"Titre","default":"Bénéfice"},{"type":"richtext","id":"text","label":"Texte","default":"<p>Décrivez ce que le client y gagne.</p>"},{"type":"image_picker","id":"image","label":"Image"},{"type":"range","id":"fallback","label":"Sinon, utiliser la photo produit n°","min":0,"max":10,"step":1,"default":0,"info":"0 = aucune (emplacement gris)"},{"type":"text","id":"image_label","label":"Repère de l'image","default":"Image à générer"}]}],"presets":[{"name":"RR · Bénéfices","blocks":[{"type":"benefit"},{"type":"benefit"},{"type":"benefit"}]}]}
{% endschema %}
