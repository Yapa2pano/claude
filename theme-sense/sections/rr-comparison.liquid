{{ 'reliefroll.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign s = section.settings
  assign cols = ''
  if s.col_1 != blank
    assign cols = cols | append: s.col_1 | append: '|'
  endif
  if s.col_2 != blank
    assign cols = cols | append: s.col_2 | append: '|'
  endif
  if s.col_3 != blank
    assign cols = cols | append: s.col_3 | append: '|'
  endif
  if s.col_4 != blank
    assign cols = cols | append: s.col_4 | append: '|'
  endif
  assign cols = cols | split: '|'
-%}
<div class="rr rr--{{ s.bg }}" style="--rr-pt: {{ s.pt }}px; --rr-pb: {{ s.pb }}px;">
  <div class="rr-wrap">
    <div class="rr-head">
      {%- if s.eyebrow != blank -%}<p class="rr-eyebrow">{{ s.eyebrow }}</p>{%- endif -%}
      {%- if s.heading != blank -%}<h2 class="rr-h2">{{ s.heading }}</h2>{%- endif -%}
      {%- if s.text != blank -%}<div class="rr-lead">{{ s.text }}</div>{%- endif -%}
    </div>
    <div class="rr-compare">
      <table>
        <thead>
          <tr>
            <th scope="col"><span class="visually-hidden">Critère</span></th>
            <th scope="col" class="rr-compare__us">{{ s.col_us }}</th>
            {%- for c in cols -%}<th scope="col">{{ c }}</th>{%- endfor -%}
          </tr>
        </thead>
        <tbody>
          {%- for block in section.blocks -%}
            {%- assign values = block.settings.values | split: ',' -%}
            <tr {{ block.shopify_attributes }}>
              <th scope="row">{{ block.settings.label }}</th>
              {%- for n in (0..cols.size) -%}
                {%- assign v = values[n] | strip | downcase -%}
                <td{% if n == 0 %} class="rr-compare__us"{% endif %}>
                  {%- case v -%}
                    {%- when 'oui' -%}<span class="rr-yes">{% render 'rr-icon', name: 'check-circle' %}<span class="visually-hidden">Oui</span></span>
                    {%- when 'non' -%}<span class="rr-no">{% render 'rr-icon', name: 'x-circle' %}<span class="visually-hidden">Non</span></span>
                    {%- when blank -%}<span class="rr-no">–</span>
                    {%- else -%}{{ values[n] | strip }}
                  {%- endcase -%}
                </td>
              {%- endfor -%}
            </tr>
          {%- endfor -%}
        </tbody>
      </table>
    </div>
    {%- if s.note != blank -%}<p class="rr-muted rr-compare__note">{{ s.note }}</p>{%- endif -%}
  </div>
</div>
{% schema %}
{"name":"RR · Comparatif","tag":"section","class":"rr-section","settings":[{"type":"text","id":"eyebrow","label":"Petit titre (au-dessus)"},{"type":"text","id":"heading","label":"Titre","default":"Face aux autres solutions"},{"type":"richtext","id":"text","label":"Sous-titre"},{"type":"header","content":"Colonnes"},{"type":"text","id":"col_us","label":"Votre colonne (mise en avant)","default":"ReliefRoll"},{"type":"text","id":"col_1","label":"Colonne 2","default":"Crème"},{"type":"text","id":"col_2","label":"Colonne 3","default":"Coussin"},{"type":"text","id":"col_3","label":"Colonne 4"},{"type":"text","id":"col_4","label":"Colonne 5"},{"type":"text","id":"note","label":"Note sous le tableau"},{"type":"header","content":"Style de la section"},{"type":"select","id":"bg","label":"Couleur de fond","options":[{"value":"white","label":"Blanc"},{"value":"sand","label":"Sable"},{"value":"mint","label":"Menthe"},{"value":"ink","label":"Nuit (foncé)"}],"default":"white"},{"type":"range","id":"pt","label":"Marge haute","min":0,"max":140,"step":4,"unit":"px","default":72},{"type":"range","id":"pb","label":"Marge basse","min":0,"max":140,"step":4,"unit":"px","default":72}],"blocks":[{"type":"row","name":"Ligne","settings":[{"type":"text","id":"label","label":"Critère","default":"Critère"},{"type":"text","id":"values","label":"Valeurs séparées par des virgules","default":"oui, non, non","info":"Dans l'ordre des colonnes. Écrivez oui / non pour une icône, ou un texte court."}]}],"presets":[{"name":"RR · Comparatif","blocks":[{"type":"row"},{"type":"row"},{"type":"row"}]}]}
{% endschema %}
