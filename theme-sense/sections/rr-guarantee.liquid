{{ 'reliefroll.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign s = section.settings
  assign has_media = false
  if s.image != blank or s.fallback > 0
    assign has_media = true
  endif
-%}
<div class="rr rr--{{ s.bg }}" style="--rr-pt: {{ s.pt }}px; --rr-pb: {{ s.pb }}px;">
  <div class="rr-wrap">
    <div class="rr-guarantee{% if has_media %} rr-guarantee--media{% endif %}">
      {%- if has_media -%}
        <div class="rr-guarantee__media">
          {% render 'rr-media', image: s.image, fallback: s.fallback, label: s.image_label, ratio: '4 / 5', sizes: '(min-width: 750px) 40vw, 100vw', product: product %}
          <div class="rr-seal rr-seal--badge"><strong>{{ s.seal_number }}</strong><span>{{ s.seal_text }}</span></div>
        </div>
      {%- else -%}
        <div class="rr-seal"><strong>{{ s.seal_number }}</strong><span>{{ s.seal_text }}</span></div>
      {%- endif -%}
      <div>
        {%- if s.eyebrow != blank -%}<p class="rr-eyebrow">{{ s.eyebrow }}</p>{%- endif -%}
        <h2 class="rr-h2">{{ s.heading }}</h2>
        <div class="rr-lead" style="margin-bottom:0;">{{ s.text }}</div>
        {%- if section.blocks.size > 0 -%}
          <div class="rr-perks">
            {%- for block in section.blocks -%}
              <div class="rr-perk" {{ block.shopify_attributes }}>{% render 'rr-icon', name: block.settings.icon %}{{ block.settings.text }}</div>
            {%- endfor -%}
          </div>
        {%- endif -%}
        {%- if s.quote != blank -%}
          <figure class="rr-proof">
            {% render 'rr-stars', rating: 5, size: 'sm' %}
            <blockquote>« {{ s.quote }} »</blockquote>
            {%- if s.quote_author != blank -%}
              <figcaption><strong>{{ s.quote_author }}</strong>{% if s.quote_source != blank %} · {{ s.quote_source }}{% endif %}</figcaption>
            {%- endif -%}
          </figure>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>
{% stylesheet %}
/* Garantie avec image + preuve client */
.rr-guarantee--media { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); }
.rr-guarantee__media { position: relative; }
.rr-seal--badge {
  position: absolute;
  right: -18px;
  bottom: -18px;
  width: 132px;
  height: 132px;
}
.rr-seal--badge strong { font-size: 42px; }
.rr-seal--badge span { font-size: 10px; max-width: 90px; }
.rr-proof {
  margin: 26px 0 0;
  padding: 18px 20px;
  border-radius: var(--rr-radius-sm);
  background: var(--rr-mint);
  text-align: left;
}
.rr-proof blockquote { margin: 8px 0; font-size: 16px; line-height: 1.55; font-style: italic; color: var(--rr-ink); }
.rr-proof figcaption { font-size: 14px; color: var(--rr-muted); }
.rr-proof figcaption strong { color: var(--rr-ink); }
@media (max-width: 749px) {
  .rr-guarantee--media { grid-template-columns: 1fr; }
  .rr-seal--badge { right: 12px; bottom: -22px; width: 110px; height: 110px; }
  .rr-seal--badge strong { font-size: 34px; }
}
{% endstylesheet %}

