{{ 'reliefroll.css' | asset_url | stylesheet_tag }}
{%- assign s = section.settings -%}
<div class="rr rr--{{ s.bg }}" style="--rr-pt: {{ s.pt }}px; --rr-pb: {{ s.pb }}px;">
  <div class="rr-wrap">
    <div class="rr-guarantee">
      <div class="rr-seal"><strong>{{ s.seal_number }}</strong><span>{{ s.seal_text }}</span></div>
      <div>
        {%- if s.eyebrow != blank -%}<p class="rr-eyebrow">{{ s.eyebrow }}</p>{%- endif -%}
        <h2 class="rr-h2">{{ s.heading }}</h2>
        <div class="rr-lead" style="margin-bottom:0;">{{ s.text }}</div>
        {%- if section.blocks.size > 0 -%}
          <div class="rr-perks">
            {%- for block in section.blocks -%}
              <div class="rr-perk" {{ block.shopify_attributes }}>{% render 'rr-icon', name: block.settings.icon %}{{ block.settings.text }}</div>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>
{% schema %}
{"name":"RR · Garantie","tag":"section","class":"rr-section","settings":[{"type":"text","id":"seal_number","label":"Chiffre du sceau","default":"30"},{"type":"text","id":"seal_text","label":"Texte du sceau","default":"jours pour tester"},{"type":"text","id":"eyebrow","label":"Petit titre (au-dessus)"},{"type":"text","id":"heading","label":"Titre","default":"Satisfait ou remboursé"},{"type":"richtext","id":"text","label":"Texte","default":"<p>Testez sans risque.</p>"},{"type":"header","content":"Style de la section"},{"type":"select","id":"bg","label":"Couleur de fond","options":[{"value":"white","label":"Blanc"},{"value":"sand","label":"Sable"},{"value":"mint","label":"Menthe"},{"value":"ink","label":"Nuit (foncé)"}],"default":"white"},{"type":"range","id":"pt","label":"Marge haute","min":0,"max":140,"step":4,"unit":"px","default":72},{"type":"range","id":"pb","label":"Marge basse","min":0,"max":140,"step":4,"unit":"px","default":72}],"blocks":[{"type":"perk","name":"Avantage","settings":[{"type":"select","id":"icon","label":"Icône","options":[{"value":"check","label":"check"},{"value":"check-circle","label":"check-circle"},{"value":"truck","label":"truck"},{"value":"shield","label":"shield"},{"value":"refresh","label":"refresh"},{"value":"lock","label":"lock"},{"value":"clock","label":"clock"},{"value":"battery","label":"battery"},{"value":"bolt","label":"bolt"},{"value":"hand","label":"hand"},{"value":"moon","label":"moon"},{"value":"sun","label":"sun"},{"value":"heart","label":"heart"},{"value":"leaf","label":"leaf"},{"value":"usb","label":"usb"},{"value":"waves","label":"waves"},{"value":"target","label":"target"},{"value":"user","label":"user"},{"value":"bed","label":"bed"},{"value":"feather","label":"feather"},{"value":"gift","label":"gift"},{"value":"chat","label":"chat"},{"value":"box","label":"box"},{"value":"star","label":"star"},{"value":"x-circle","label":"x-circle"}],"default":"check-circle"},{"type":"text","id":"text","label":"Texte","default":"Avantage"}]}],"presets":[{"name":"RR · Garantie"}]}
{% endschema %}
